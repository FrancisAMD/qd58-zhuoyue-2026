{
  "schemaVersion": "1.0.0",
  "title": "中国普通高等学校本科专业学科门类（一级分类）",
  "description": "按教育部学科门类代码平铺分类，共 13 个门类。原通俗口径中的“文科”拆分为哲学、经济学、法学、教育学、文学、历史学、管理学、艺术学 8 个门类；理学、工学、农学、医学保持门类级不变；军事学单列，仅适用于军队院校。",
  "standard": {
    "name": "普通高等学校本科专业目录（2025年）",
    "issuer": "教育部",
    "level": "学科门类（第一级）",
    "released": "2025-04"
  },
  "rules": {
    "codeScheme": "沿用教育部官方两位门类代码，不重排为 1-12，便于与目录、学位授予信息、教育统计年报对接",
    "militaryScience": "军事学门类（11）普通高等学校本科不设，仅军队院校按军队院校专业目录设置；打标时只用于军队院校及军事类专业，普通高校不应出现该门类",
    "dualTrack": "艺术学、体育学（在 04 教育学门类下）在高考招生中另设艺术类、体育类批次；做招录统计时应在门类之外单独记录招生类别字段，不要与门类混用",
    "borderline": "公安学类归 03 法学门类，公安技术类归 08 工学门类"
  },
