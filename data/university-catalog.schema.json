{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FrancisAMD/qd58-zhuoyue-2026/blob/main/data/university-catalog.schema.json",
  "title": "Zhuoyue 2026 University Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "universities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "universities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/university"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "country_name_zh",
        "country_name_en",
        "province_code",
        "province_name_zh",
        "city_name_zh"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "country_name_zh": {
          "type": "string",
          "minLength": 1
        },
        "country_name_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "province_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "province_name_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "city_name_zh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "campus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_zh",
        "name_en",
        "is_main_campus",
        "is_branch_campus",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,79}$"
        },
        "name_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_main_campus": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "is_branch_campus": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "name_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "name_en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "publisher",
        "title",
        "url",
        "accessed_at",
        "supports_fields"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "government",
            "education_authority",
            "institution",
            "other"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "supports_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogField"
          },
          "uniqueItems": true
        }
      }
    },
    "university": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "official_school_code",
        "name_zh",
        "name_en",
        "aliases",
        "category",
        "degree_levels",
        "ownership",
        "school_type_tags",
        "project_tags",
        "double_first_class_disciplines",
        "location",
        "has_branch_campus",
        "campus_structure",
        "campus_info_status",
        "campuses",
        "source_records",
        "verification",
        "status",
        "merged_into"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"
        },
        "official_school_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9-]{2,32}$"
        },
        "name_zh": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "category": {
          "enum": [
            "mainland",
            "hmt",
            "overseas"
          ]
        },
        "degree_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "undergraduate",
              "postgraduate",
              "doctoral",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "ownership": {
          "enum": [
            "public",
            "private",
            "cooperative",
            "other",
            "unknown"
          ]
        },
        "school_type_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "comprehensive",
              "science_engineering",
              "normal",
              "agriculture_forestry",
              "medical",
              "finance_economics",
              "language",
              "law_politics",
              "sports",
              "arts",
              "ethnic",
              "military",
              "public_security",
              "vocational",
              "sino_foreign_cooperative",
              "religious",
              "other",
              "unknown"
            ]
          }
        },
        "project_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "project_985_legacy",
              "project_211_legacy",
              "double_first_class_round1",
              "double_first_class_round2"
            ]
          }
        },
        "double_first_class_disciplines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "campus_structure": {
          "enum": [
            "single",
            "multiple",
            "unknown"
          ]
        },
        "campus_info_status": {
          "enum": [
            "complete",
            "partial",
            "not_collected",
            "unknown"
          ]
        },
        "campuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/campus"
          }
        },
        "source_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verified_at",
            "verified_fields",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "draft",
                "needs_review",
                "verified"
              ]
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "verified_fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/catalogField"
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "merged"
          ]
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_branch_campus": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "name_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "name_en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "mainland"
              }
            }
          },
          "then": {
            "properties": {
              "degree_levels": {
                "contains": {
                  "const": "undergraduate"
                }
              },
              "location": {
                "properties": {
                  "country_code": {
                    "const": "CN"
                  },
                  "province_code": {
                    "type": "string",
                    "minLength": 2
                  },
                  "province_name_zh": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "hmt"
              }
            }
          },
          "then": {
            "properties": {
              "project_tags": {
                "maxItems": 0
              },
              "location": {
                "properties": {
                  "country_code": {
                    "enum": [
                      "HK",
                      "MO",
                      "TW"
                    ]
                  },
                  "province_code": {
                    "type": "null"
                  },
                  "province_name_zh": {
                    "type": "null"
                  },
                  "city_name_zh": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "overseas"
              }
            }
          },
          "then": {
            "properties": {
              "project_tags": {
                "maxItems": 0
              },
              "location": {
                "properties": {
                  "country_code": {
                    "not": {
                      "enum": [
                        "CN",
                        "HK",
                        "MO",
                        "TW"
                      ]
                    }
                  },
                  "province_code": {
                    "type": "null"
                  },
                  "province_name_zh": {
                    "type": "null"
                  },
                  "city_name_zh": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "catalogField": {
      "type": "string",
      "enum": [
        "official_school_code",
        "name_zh",
        "name_en",
        "aliases",
        "category",
        "degree_levels",
        "ownership",
        "school_type_tags",
        "project_tags",
        "double_first_class_disciplines",
        "location",
        "campus_structure",
        "has_branch_campus",
        "campus_info_status",
        "campuses"
      ]
    }
  }
}
